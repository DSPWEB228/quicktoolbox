{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/summarize",
        "function": "summarizeText"
      },
      {
        "source": "/api/convert",
        "function": "convertFile"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "emulators": {
    "hosting": { "port": 5000 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true },
    "singleProjectMode": true
  }
}
